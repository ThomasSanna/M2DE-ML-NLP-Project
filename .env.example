LDAP_ADMIN_PASSWORD=ChangeMeAdmin2026!
LDAP_CONFIG_PASSWORD=ChangeMeConfig2026!
MARIADB_ROOT_PASSWORD=ChangeMeRoot2026!
MARIADB_PASSWORD=ChangeMeGlpi2026!

# --- GLPI (scripts/configure-glpi.sh) - an empty value leaves the setting unchanged
GLPI_URL_BASE=http://localhost:8080
# LDAP bind used by GLPI (default: cn=admin + LDAP_ADMIN_PASSWORD)
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# SMTP relay (Brevo: Settings > API keys > SMTP keys)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME="GLPI Support"
MAIL_ADMIN=
MAIL_ADMIN_NAME=
MAIL_SIGNATURE="-- Equipe support demo"

# Satisfaction survey (feedback w1)
SURVEY_RATE=100
SURVEY_COMMENT_THRESHOLD=2
TICKET_AUTOCLOSE_DAYS=7

# --- Memory API (FastAPI + PostgreSQL/pgvector)
POSTGRES_USER=memoire
POSTGRES_PASSWORD=ChangeMePg2026!
POSTGRES_DB=memoire
# Postgres port on the host machine (local dev / tests)
POSTGRES_PORT=5432
API_PORT=8000
# Key to send in the X-API-Key header for the /api/v1/memory and /api/v1/answer routes
API_KEY=ChangeMeApiKey2026
# GLPI webhook secret (empty = signature not verified)
GLPI_WEBHOOK_SECRET=
# University embeddings server (OpenAI-compatible vLLM, URL with /v1, VPN required)
EMBEDDING_BASE_URL=http://193.48.31.6:31550/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-multilingual-gemma2
# University LLM (Hugging Face TGI, OpenAI-compatible, URL with /v1, VPN required).
# Required, like RERANKER_BASE_URL: the API does not start without it. While the 12B
# is unreachable, use the 4B: http://193.48.31.6:30091/v1
LLM_BASE_URL=http://193.48.31.6:32297/v1
LLM_MODEL=google/gemma3-12b-it
# University reranker (POST /rerank, no /v1)
RERANKER_BASE_URL=http://193.48.31.6:31127
# Exa web search (https://exa.ai); empty key = web search disabled
EXA_API_KEY=
# Comma-separated domains to restrict web search to (empty = whole web)
EXA_INCLUDE_DOMAINS=
