LDAP_ADMIN_PASSWORD=ChangeMeAdmin2026!
LDAP_CONFIG_PASSWORD=ChangeMeConfig2026!
MARIADB_ROOT_PASSWORD=ChangeMeRoot2026!
MARIADB_PASSWORD=ChangeMeGlpi2026!

# --- GLPI (scripts/configure-glpi.sh) — une valeur vide laisse le réglage tel quel
GLPI_URL_BASE=http://localhost:8080
# Bind LDAP utilisé par GLPI (défaut : cn=admin + LDAP_ADMIN_PASSWORD)
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# Relais SMTP (Brevo : Paramètres > Clés API > Clés SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME="GLPI Support"
MAIL_ADMIN=
MAIL_ADMIN_NAME=
MAIL_SIGNATURE="-- Equipe support demo"

# Enquête de satisfaction (feedback w1)
SURVEY_RATE=100
SURVEY_COMMENT_THRESHOLD=2
TICKET_AUTOCLOSE_DAYS=7

# --- API mémoire (FastAPI + PostgreSQL/pgvector)
POSTGRES_USER=memoire
POSTGRES_PASSWORD=ChangeMePg2026!
POSTGRES_DB=memoire
# Port de Postgres sur la machine hôte (dev local / tests)
POSTGRES_PORT=5432
API_PORT=8000
# Clé à passer dans l'en-tête X-API-Key pour les routes /api/v1/memory
API_KEY=ChangeMeApiKey2026
# Secret du webhook GLPI (vide = signature non vérifiée, et webhook non créé par
# scripts/configure-glpi.sh). Générer : openssl rand -hex 32
GLPI_WEBHOOK_SECRET=
# Serveur d'embeddings de l'université (vLLM compatible OpenAI, URL avec /v1, VPN requis)
EMBEDDING_BASE_URL=http://193.48.31.6:31550/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-multilingual-gemma2

# LLM de génération (vLLM de l'université, VPN requis)
LLM_BASE_URL=http://193.48.31.6:32297/v1
LLM_API_KEY=
LLM_MODEL=google/gemma3-12b-it
# Tokens regroupés par événement SSE (route /api/v1/tickets/{id}/answer/stream)
SSE_CHUNK_TOKENS=6

# --- Accès de l'API mémoire à GLPI (scripts/configure-glpi.sh les écrit dans GLPI)
# Jetons générés par vous : openssl rand -hex 20
GLPI_BOT_USER=chatbot
GLPI_USER_TOKEN=
GLPI_APP_TOKEN=
# false = réponse publique, mail direct au demandeur ; true = suivi privé à valider
GLPI_FOLLOWUP_PRIVATE=false
# Utilisateur MariaDB en lecture seule sur les tables tickets/suivis/solutions/enquêtes
GLPI_DB_RO_USER=memoire_ro
GLPI_DB_RO_PASSWORD=
